# Leave unset for local dev — the Vite dev server proxies /api to the backend
# (see vite.config.js) so cookies stay same-origin. Only set this if the
# frontend and backend are deployed to genuinely different origins/domains,
# and see the cookie SameSite note in backend/src/routes/auth.js first.
# VITE_API_URL=http://localhost:8787
