# Required: Anthropic API key, used server-side only (never sent to the client).
ANTHROPIC_API_KEY=

# Port the backend HTTP server listens on.
PORT=8787

# Origin of the frontend dev server, for CORS + cookie settings.
FRONTEND_ORIGIN=http://localhost:5173

# Random long string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Where the SQLite database file is written.
DB_PATH=./data/waypoint.db

# If unset, magic sign-in links are printed to the server console instead of emailed
# (see src/services/mail.js). Set to "true" once a real mail provider is wired up.
MAIL_ENABLED=false
